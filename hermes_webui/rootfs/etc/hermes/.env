# Managed environment for Hermes, part of the app image. Hermes loads it after $HERMES_HOME/.env and it
# wins, so nothing in /config/hermes/.env can open an inbound listener on another interface: the app has
# no port for one, and some webhook-style platforms bind every interface by default, others when a
# *_HOST setting asks for it. For these platforms the environment also beats their config.yaml settings.
# It holds when config.yaml is broken and Hermes skips the managed config.yaml next to this file as well.
# Every name here is reserved in the env_vars option.
WEBHOOK_ENABLED=false
MSGRAPH_WEBHOOK_ENABLED=false
# Too short to be a usable key, so the API server stays off.
API_SERVER_KEY=off
# Empty, so Telegram uses long polling, which connects outward only.
TELEGRAM_WEBHOOK_URL=
LINE_HOST=127.0.0.1
WHATSAPP_CLOUD_WEBHOOK_HOST=127.0.0.1
WECOM_CALLBACK_HOST=127.0.0.1
# Loopback is already their default; pinned so that a wildcard host in .env can't widen it.
A2A_HOST=127.0.0.1
SMS_WEBHOOK_HOST=127.0.0.1
BLUEBUBBLES_WEBHOOK_HOST=127.0.0.1
FEISHU_WEBHOOK_HOST=127.0.0.1
# Teams binds every interface by default. The managed config.yaml turns it off; this covers a broken one.
TEAMS_HOST=127.0.0.1
